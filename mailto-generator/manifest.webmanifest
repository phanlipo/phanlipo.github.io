{
  "id": "./",
  "name": "Mailto-Generator",
  "short_name": "Mailto",
  "description": "Mailto-Links bauen: Empfänger, CC, BCC, Betreff und Text eintragen – als Link, HTML oder Markdown kopieren, teilen, als QR-Code zeigen oder vorhandene Links zerlegen.",
  "lang": "de",
  "name_localized": {
    "en": "Mailto Generator"
  },
  "short_name_localized": {
    "en": "Mailto"
  },
  "description_localized": {
    "en": "Build mailto links: enter recipients, CC, BCC, subject and text – copy as a link, HTML or Markdown, share, show as a QR code or take existing links apart."
  },
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4f6f9",
  "theme_color": "#1d6fa5",
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
