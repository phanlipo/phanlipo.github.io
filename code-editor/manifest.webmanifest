{
  "id": "/code-editor/",
  "name": "Code-Editor",
  "short_name": "Code-Editor",
  "description": "Textdateien ansehen und bearbeiten – JSON, Python, Markdown, C++, Shell, XML und viele mehr, mit farbiger Syntax, Zeilennummern und Suchen & Ersetzen.",
  "lang": "de",
  "name_localized": {
    "en": "Code Editor"
  },
  "short_name_localized": {
    "en": "Code Editor"
  },
  "description_localized": {
    "en": "View and edit text files – JSON, Python, Markdown, C++, shell, XML and many more, with coloured syntax, line numbers and find & replace."
  },
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4f6f9",
  "theme_color": "#6d28d9",
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": [
            "text/*",
            "application/json",
            "application/xml",
            "application/javascript",
            "application/x-sh",
            "application/x-yaml",
            "application/yaml",
            "application/toml",
            "application/sql",
            ".txt",
            ".md",
            ".json",
            ".xml",
            ".yaml",
            ".yml",
            ".toml",
            ".ini",
            ".cfg",
            ".conf",
            ".properties",
            ".log",
            ".csv",
            ".tsv",
            ".html",
            ".htm",
            ".css",
            ".scss",
            ".js",
            ".mjs",
            ".cjs",
            ".jsx",
            ".ts",
            ".tsx",
            ".py",
            ".c",
            ".h",
            ".cpp",
            ".cc",
            ".hpp",
            ".cs",
            ".java",
            ".kt",
            ".go",
            ".rs",
            ".rb",
            ".php",
            ".pl",
            ".lua",
            ".r",
            ".swift",
            ".dart",
            ".sql",
            ".sh",
            ".bash",
            ".zsh",
            ".ps1",
            ".bat",
            ".cmd",
            ".tex",
            ".diff",
            ".patch",
            ".ino",
            ".gcode"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./?opened=1",
      "name": "Code-Editor",
      "accept": {
        "text/plain": [
          ".txt",
          ".ini",
          ".cfg",
          ".conf",
          ".properties",
          ".log",
          ".ps1",
          ".bat",
          ".cmd",
          ".gcode"
        ],
        "text/markdown": [
          ".md"
        ],
        "application/json": [
          ".json"
        ],
        "application/xml": [
          ".xml"
        ],
        "application/yaml": [
          ".yaml",
          ".yml"
        ],
        "application/toml": [
          ".toml"
        ],
        "text/csv": [
          ".csv"
        ],
        "text/tab-separated-values": [
          ".tsv"
        ],
        "text/html": [
          ".html",
          ".htm"
        ],
        "text/css": [
          ".css"
        ],
        "text/x-scss": [
          ".scss"
        ],
        "text/javascript": [
          ".js",
          ".mjs",
          ".cjs",
          ".jsx"
        ],
        "text/x-typescript": [
          ".ts",
          ".tsx"
        ],
        "text/x-python": [
          ".py"
        ],
        "text/x-c": [
          ".c",
          ".h"
        ],
        "text/x-c++": [
          ".cpp",
          ".cc",
          ".hpp",
          ".ino"
        ],
        "text/x-csharp": [
          ".cs"
        ],
        "text/x-java": [
          ".java"
        ],
        "text/x-kotlin": [
          ".kt"
        ],
        "text/x-go": [
          ".go"
        ],
        "text/x-rust": [
          ".rs"
        ],
        "text/x-ruby": [
          ".rb"
        ],
        "application/x-httpd-php": [
          ".php"
        ],
        "text/x-perl": [
          ".pl"
        ],
        "text/x-lua": [
          ".lua"
        ],
        "text/x-r": [
          ".r"
        ],
        "text/x-swift": [
          ".swift"
        ],
        "text/x-dart": [
          ".dart"
        ],
        "application/sql": [
          ".sql"
        ],
        "application/x-sh": [
          ".sh",
          ".bash",
          ".zsh"
        ],
        "application/x-tex": [
          ".tex"
        ],
        "text/x-diff": [
          ".diff",
          ".patch"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-new"
  },
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
