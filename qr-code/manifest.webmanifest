{
  "id": "./",
  "name": "QR-Code-Generator",
  "short_name": "QR-Code",
  "description": "QR-Codes für Links, Text und WLAN erzeugen – Links direkt aus anderen Apps hierher teilen (Android), mit Verlauf.",
  "lang": "de",
  "name_localized": {
    "en": "QR Code Generator"
  },
  "short_name_localized": {
    "en": "QR Code"
  },
  "description_localized": {
    "en": "Create QR codes for links, text and Wi-Fi – share links straight from other apps (Android), with history."
  },
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4f6f9",
  "theme_color": "#15803d",
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
