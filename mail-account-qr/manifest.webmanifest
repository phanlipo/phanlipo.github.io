{
  "id": "./",
  "name": "Mail-Konto per QR",
  "short_name": "Konto-QR",
  "description": "E-Mail-Konten als QR-Code für Thunderbird auf dem Handy erstellen – und Thunderbird-QR-Codes per Kamera, Bild oder Text lesen, z. B. um die Daten in eine andere Mail-App zu übertragen.",
  "lang": "de",
  "name_localized": {
    "en": "Mail Account QR"
  },
  "short_name_localized": {
    "en": "Account QR"
  },
  "description_localized": {
    "en": "Create QR codes of email accounts for Thunderbird on the phone – and read Thunderbird QR codes by camera, picture or text, e.g. to move the settings into another mail app."
  },
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4f6f9",
  "theme_color": "#1f5fa8",
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
