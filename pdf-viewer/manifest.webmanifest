{
  "id": "./",
  "name": "PDF ansehen",
  "short_name": "PDF ansehen",
  "description": "PDF-Dateien im Vollbild lesen – Leisten blenden sich aus, ein Tippen holt Menü und Teilen zurück. Ohne Upload.",
  "lang": "de",
  "name_localized": {
    "en": "PDF Viewer"
  },
  "short_name_localized": {
    "en": "PDF Viewer"
  },
  "description_localized": {
    "en": "Read PDF files full screen – the bars hide, one tap brings back the menu and sharing. No upload."
  },
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "background_color": "#f4f6f9",
  "theme_color": "#b42318",
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": [
            "application/pdf",
            ".pdf"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./?opened=1",
      "name": "PDF ansehen",
      "accept": {
        "application/pdf": [
          ".pdf"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-new"
  },
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
