{
  "id": "./",
  "name": "Audio Studio",
  "short_name": "Audio Studio",
  "description": "Audiodateien kürzen und schneiden, Lautstärke anpassen, ein- und ausblenden und als WAV, Opus oder AAC speichern – direkt im Browser, die Datei verlässt das Gerät nicht.",
  "lang": "de",
  "name_localized": {
    "en": "Audio Studio"
  },
  "short_name_localized": {
    "en": "Audio Studio"
  },
  "description_localized": {
    "en": "Trim and cut audio files, adjust the volume, fade in and out and save as WAV, Opus or AAC – right in the browser, the file never leaves the device."
  },
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4f6f9",
  "theme_color": "#8b3a62",
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": [
            "audio/*",
            "video/*",
            ".mp3",
            ".m4a",
            ".aac",
            ".wav",
            ".ogg",
            ".opus",
            ".oga",
            ".flac",
            ".webm",
            ".mp4"
          ]
        }
      ]
    }
  },
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
