{
  "id": "./",
  "name": "Visitenkarten",
  "short_name": "Visitenkarte",
  "description": "Visitenkarten gestalten: Texte, Bilder, Logos, Formen und QR-Code (auch vCard) frei anordnen, Farben wählen – als Bild oder A4-PDF mit Schnittmarken drucken, als Vorlage speichern und teilen.",
  "lang": "de",
  "name_localized": {
    "en": "Business Cards"
  },
  "short_name_localized": {
    "en": "Cards"
  },
  "description_localized": {
    "en": "Design business cards: arrange text, pictures, logos, shapes and a QR code (vCard too), pick colours – print as an image or A4 PDF with crop marks, save and share as a template."
  },
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4f6f9",
  "theme_color": "#0f766e",
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": [
            "image/*",
            ".png",
            ".jpg",
            ".jpeg",
            ".webp",
            ".heic",
            ".heif"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./?opened=1",
      "name": "Visitenkarten",
      "accept": {
        "image/png": [
          ".png"
        ],
        "image/jpeg": [
          ".jpg",
          ".jpeg"
        ],
        "image/webp": [
          ".webp"
        ],
        "image/heic": [
          ".heic"
        ],
        "image/heif": [
          ".heif"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-new"
  },
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
