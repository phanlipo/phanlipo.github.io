{
  "id": "./",
  "name": "Video zu Audio",
  "short_name": "Video→Audio",
  "description": "Die Tonspur aus einem Video speichern – als Original ohne Qualitätsverlust (z. B. .m4a) oder als WAV, direkt im Browser: das Video verlässt das Gerät nicht.",
  "lang": "de",
  "name_localized": {
    "en": "Video to Audio"
  },
  "short_name_localized": {
    "en": "Video→Audio"
  },
  "description_localized": {
    "en": "Save the sound track of a video – as the original without quality loss (e.g. .m4a) or as WAV, right in the browser: the video never leaves the device."
  },
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4f6f9",
  "theme_color": "#b91c1c",
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": [
            "video/*",
            ".mp4",
            ".m4v",
            ".mov",
            ".webm",
            ".mkv",
            ".3gp"
          ]
        }
      ]
    }
  },
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
