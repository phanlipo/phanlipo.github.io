{
  "id": "./",
  "name": "Bildkonverter",
  "short_name": "Konverter",
  "description": "Bilder umwandeln und komprimieren – JPG, PNG, WebP, HEIC (iPhone), AVIF, GIF, BMP, ICO und SVG, auch mehrere auf einmal, mit Qualität, Größe und maximaler Dateigröße, ganz ohne Upload.",
  "lang": "de",
  "name_localized": {
    "en": "Image Converter"
  },
  "short_name_localized": {
    "en": "Converter"
  },
  "description_localized": {
    "en": "Convert and compress images – JPG, PNG, WebP, HEIC (iPhone), AVIF, GIF, BMP, ICO and SVG, several at once, with quality, size and a maximum file size, without any upload."
  },
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4f6f9",
  "theme_color": "#7e22ce",
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": [
            "image/*",
            ".jpg",
            ".jpeg",
            ".png",
            ".webp",
            ".heic",
            ".heif",
            ".avif",
            ".gif",
            ".bmp",
            ".ico",
            ".svg"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./?opened=1",
      "name": "Bildkonverter",
      "accept": {
        "image/jpeg": [
          ".jpg",
          ".jpeg"
        ],
        "image/png": [
          ".png"
        ],
        "image/webp": [
          ".webp"
        ],
        "image/heic": [
          ".heic"
        ],
        "image/heif": [
          ".heif"
        ],
        "image/avif": [
          ".avif"
        ],
        "image/gif": [
          ".gif"
        ],
        "image/bmp": [
          ".bmp"
        ],
        "image/x-icon": [
          ".ico"
        ],
        "image/svg+xml": [
          ".svg"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-new"
  },
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
