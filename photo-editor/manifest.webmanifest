{
  "id": "/photo-editor/",
  "name": "Foto-Editor",
  "short_name": "Foto-Editor",
  "description": "Aus einem Foto ein Comic-Bild oder eine schwarz-weiße Zeichnung zum Ausmalen machen – Filter wählen, anpassen, speichern, teilen oder drucken, ganz ohne Upload.",
  "lang": "de",
  "name_localized": {
    "en": "Photo Editor"
  },
  "short_name_localized": {
    "en": "Photo Editor"
  },
  "description_localized": {
    "en": "Turn a photo into a comic picture or a black-and-white drawing to colour in – pick a filter, adjust it, save, share or print, without any upload."
  },
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4f6f9",
  "theme_color": "#be185d",
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": [
            "image/*",
            ".heic",
            ".heif"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./?opened=1",
      "name": "Foto-Editor",
      "accept": {
        "image/heic": [
          ".heic"
        ],
        "image/heif": [
          ".heif"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-new"
  },
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
