{
  "id": "./",
  "name": "Code-Scanner",
  "short_name": "Code-Scanner",
  "description": "QR-Codes, Barcodes, DataMatrix, Aztec, PDF417 und weitere Codes mit Kamera oder Foto lesen – Inhalt im Original, als QR-Code und übersichtlich aufbereitet (WLAN, Kontakt, Überweisung, GS1 …).",
  "lang": "de",
  "name_localized": {
    "en": "Code Scanner"
  },
  "short_name_localized": {
    "en": "Code Scanner"
  },
  "description_localized": {
    "en": "Read QR codes, barcodes, DataMatrix, Aztec, PDF417 and more with the camera or a photo – content in the original, as a QR code and neatly broken down (Wi-Fi, contact, bank transfer, GS1 …)."
  },
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4f6f9",
  "theme_color": "#0369a1",
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": [
            "image/*",
            ".jpg",
            ".jpeg",
            ".png",
            ".webp",
            ".heic",
            ".heif"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./?opened=1",
      "name": "Code-Scanner",
      "accept": {
        "image/jpeg": [
          ".jpg",
          ".jpeg"
        ],
        "image/png": [
          ".png"
        ],
        "image/webp": [
          ".webp"
        ],
        "image/heic": [
          ".heic"
        ],
        "image/heif": [
          ".heif"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-new"
  },
  "shortcuts": [
    {
      "name": "Scannen",
      "short_name": "Scannen",
      "name_localized": {
        "en": "Scan"
      },
      "short_name_localized": {
        "en": "Scan"
      },
      "url": "./?shortcut=scan",
      "icons": [
        {
          "src": "shortcut-scan.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
