{
  "katex": {
    "package": "katex",
    "version": "0.19.1",
    "license": "MIT",
    "homepage": "https://katex.org",
    "purpose": "Formelsatz (LaTeX) im Brau-Rechner",
    "strip": "dist/",
    "files": [
      "dist/katex.min.js",
      "dist/katex.min.css",
      "dist/fonts/*.woff2"
    ]
  },
  "zxing-wasm": {
    "package": "zxing-wasm",
    "version": "3.1.6",
    "license": "MIT",
    "homepage": "https://github.com/Sec-ant/zxing-wasm",
    "purpose": "DataMatrix-Decoder (WebAssembly) im SecurPharm-Scanner",
    "strip": "dist/",
    "files": [
      "dist/iife/reader/index.js",
      "dist/reader/zxing_reader.wasm"
    ],
    "wasm": true
  },
  "zxing-library": {
    "package": "@zxing/library",
    "version": "0.23.0",
    "license": "Apache-2.0",
    "homepage": "https://github.com/zxing-js/library",
    "purpose": "Ersatz-Decoder (JavaScript) im SecurPharm-Scanner",
    "strip": "umd/",
    "files": [
      "umd/index.min.js"
    ]
  },
  "tabler-icons": {
    "package": "@tabler/icons",
    "version": "3.50.0",
    "license": "MIT",
    "homepage": "https://tabler.io/icons",
    "purpose": "Favicons – die Icons werden von scripts/build-icons.mjs in icon.svg eingebettet",
    "files": []
  },
  "transformers": {
    "package": "@huggingface/transformers",
    "version": "4.3.2",
    "license": "Apache-2.0",
    "homepage": "https://huggingface.co/docs/transformers.js",
    "purpose": "Whisper-Spracherkennung im Browser (Sprache zu Text)",
    "strip": "dist/",
    "files": [
      "dist/transformers.min.js"
    ],
    "precache": false
  },
  "onnxruntime-web": {
    "package": "onnxruntime-web",
    "version": "1.31.0-dev.20260914-8d85527a0",
    "versionFrom": {
      "entry": "transformers",
      "dependency": "onnxruntime-web"
    },
    "license": "MIT",
    "homepage": "https://onnxruntime.ai",
    "purpose": "Rechen-Engine (WebAssembly/WebGPU) für transformers.js – Version muss zu transformers passen",
    "strip": "dist/",
    "files": [
      "dist/ort-wasm-simd-threaded.asyncify.mjs",
      "dist/ort-wasm-simd-threaded.asyncify.wasm"
    ],
    "wasm": true,
    "precache": false,
    "licenseFallback": {
      "copyright": "Copyright (c) Microsoft Corporation",
      "source": "https://github.com/microsoft/onnxruntime/blob/main/LICENSE"
    }
  },
  "ogg-opus-decoder": {
    "package": "ogg-opus-decoder",
    "version": "1.7.5",
    "license": "MIT",
    "homepage": "https://github.com/eshaz/wasm-audio-decoders",
    "purpose": "Ersatz-Decoder für Ogg-Opus-Sprachnachrichten (z. B. ältere iPhones)",
    "strip": "dist/",
    "files": [
      "dist/ogg-opus-decoder.min.js"
    ],
    "wasm": true,
    "licenseFallback": {
      "copyright": "Copyright (c) 2021-2026 Ethan Halsall",
      "source": "https://github.com/eshaz/wasm-audio-decoders/blob/master/LICENSE"
    }
  }
