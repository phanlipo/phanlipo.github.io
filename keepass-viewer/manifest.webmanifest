{
  "id": "/keepass-viewer/",
  "name": "KeePass-Betrachter",
  "short_name": "KeePass",
  "description": "KeePass-Datenbank (.kdbx) im Browser öffnen, Einträge suchen und Passwörter kopieren – nur lesen, alles bleibt auf dem Gerät.",
  "lang": "de",
  "name_localized": {
    "en": "KeePass Viewer"
  },
  "short_name_localized": {
    "en": "KeePass"
  },
  "description_localized": {
    "en": "Open a KeePass database (.kdbx) in the browser, search entries and copy passwords – read only, everything stays on the device."
  },
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4f6f9",
  "theme_color": "#2e6b4b",
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": [
            ".kdbx"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./?opened=1",
      "name": "KeePass-Betrachter",
      "accept": {
        "application/x-keepass2": [
          ".kdbx"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-new"
  },
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
