{
  "id": "./",
  "name": "Dokumentenscanner",
  "short_name": "Scanner",
  "description": "Dokumente mit der Kamera oder aus Fotos scannen – Fotos auch aus der Galerie hierher teilen (Android): Ecken zuschneiden, Seiten sortieren, Schatten entfernen, als PDF speichern.",
  "lang": "de",
  "name_localized": {
    "en": "Document Scanner"
  },
  "short_name_localized": {
    "en": "Scanner"
  },
  "description_localized": {
    "en": "Scan documents with the camera or from photos – share photos from the gallery straight to it (Android): crop the corners, sort pages, remove shadows, save as PDF."
  },
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4f6f9",
  "theme_color": "#854d0e",
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": [
            "image/*",
            ".jpg",
            ".jpeg",
            ".png",
            ".webp",
            ".heic",
            ".heif"
          ]
        }
      ]
    }
  },
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
