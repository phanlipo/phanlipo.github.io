{
  "id": "./",
  "name": "PDF bearbeiten",
  "short_name": "PDF bearb.",
  "description": "PDF-Dateien zusammenführen, Seiten entfernen, drehen und neu sortieren – direkt im Browser, ohne Upload.",
  "lang": "de",
  "name_localized": {
    "en": "Edit PDF"
  },
  "short_name_localized": {
    "en": "Edit PDF"
  },
  "description_localized": {
    "en": "Merge PDF files, remove, rotate and reorder pages – right in the browser, no upload."
  },
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4f6f9",
  "theme_color": "#0369a1",
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": [
            "application/pdf",
            ".pdf"
          ]
        }
      ]
    }
  },
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
