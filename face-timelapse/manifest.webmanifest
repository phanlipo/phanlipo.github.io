{
  "id": "/face-timelapse/",
  "name": "Gesichter-Zeitraffer",
  "short_name": "Zeitraffer",
  "description": "Fotos wählen – das Gesicht wird in jedem Bild erkannt, gerade gerückt und gleich groß in die Mitte gesetzt. Reihenfolge ändern und als Video oder GIF speichern: ein Zeitraffer, wie jemand über die Jahre wächst.",
  "lang": "de",
  "name_localized": {
    "en": "Face Timelapse"
  },
  "short_name_localized": {
    "en": "Timelapse"
  },
  "description_localized": {
    "en": "Choose photos – the face is found in every picture, straightened and placed in the middle at the same size. Change the order and save as a video or GIF: a timelapse of someone growing up over the years."
  },
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4f6f9",
  "theme_color": "#0e6e8c",
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": [
            "image/*",
            ".jpg",
            ".jpeg",
            ".png",
            ".webp",
            ".heic",
            ".heif"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./?opened=1",
      "name": "Gesichter-Zeitraffer",
      "accept": {
        "image/jpeg": [
          ".jpg",
          ".jpeg"
        ],
        "image/png": [
          ".png"
        ],
        "image/webp": [
          ".webp"
        ],
        "image/heic": [
          ".heic"
        ],
        "image/heif": [
          ".heif"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-new"
  },
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
