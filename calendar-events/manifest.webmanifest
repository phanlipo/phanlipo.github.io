{
  "id": "./",
  "name": "Kalender-Termin erstellen",
  "short_name": "Termin",
  "description": "Termin mit Ort, Erinnerung und Wiederholung anlegen und in jeden Kalender übernehmen – als .ics-Datei, über Google oder Outlook oder als Link zum Teilen. Öffnet auch .ics-Dateien.",
  "lang": "de",
  "name_localized": {
    "en": "Create a calendar event"
  },
  "short_name_localized": {
    "en": "Event"
  },
  "description_localized": {
    "en": "Set up an event with place, reminder and repetition and add it to any calendar – as an .ics file, via Google or Outlook or as a link to share. Also opens .ics files."
  },
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4f6f9",
  "theme_color": "#c62828",
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": [
            "text/calendar",
            ".ics"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./?opened=1",
      "name": "Kalender-Termin erstellen",
      "accept": {
        "text/calendar": [
          ".ics"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-new"
  },
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
