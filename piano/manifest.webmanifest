{
  "id": "./",
  "name": "Klavier",
  "short_name": "Klavier",
  "description": "Klavier zum Spielen mit den Fingern – MIDI-Dateien laden, die Noten fallen als Animation auf die Tasten. Spuren stummschalten und selbst mitspielen.",
  "lang": "de",
  "name_localized": {
    "en": "Piano"
  },
  "short_name_localized": {
    "en": "Piano"
  },
  "description_localized": {
    "en": "Play the piano with your fingers – load MIDI files and watch the notes fall onto the keys. Mute parts and play along yourself."
  },
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4f6f9",
  "theme_color": "#4338ca",
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": [
            "audio/midi",
            "audio/x-midi",
            "audio/mid",
            ".mid",
            ".midi"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./?opened=1",
      "name": "Klavier",
      "accept": {
        "audio/midi": [
          ".mid",
          ".midi"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-new"
  },
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
