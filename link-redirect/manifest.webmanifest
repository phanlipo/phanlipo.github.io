  "name_localized": {
    "en": "Link Redirect"
  },
  "short_name_localized": {
    "en": "Redirect"
  },
  "description_localized": {
    "en": "Instantly forward shared links to a service of your choice – with prefix and suffix, e.g. test.de/?url=…"
  },
