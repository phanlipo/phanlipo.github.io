{
  "id": "/collage-maker/",
  "name": "Collage",
  "short_name": "Collage",
  "description": "Aus beliebig vielen Fotos eine lückenlose Collage bauen – ohne Zwischenräume, fast ohne Beschnitt, als riesiges Bild in voller Auflösung speichern. Alles bleibt auf dem Gerät.",
  "lang": "de",
  "name_localized": {
    "en": "Collage Maker"
  },
  "short_name_localized": {
    "en": "Collage"
  },
  "description_localized": {
    "en": "Turn any number of photos into a seamless collage – no gaps, hardly any cropping, saved as a huge image in full resolution. Everything stays on your device."
  },
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4f6f9",
  "theme_color": "#ad2f6e",
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": [
            "image/*",
            ".jpg",
            ".jpeg",
            ".png",
            ".webp",
            ".heic",
            ".heif",
            ".avif",
            ".gif"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./?opened=1",
      "name": "Collage",
      "accept": {
        "image/jpeg": [
          ".jpg",
          ".jpeg"
        ],
        "image/png": [
          ".png"
        ],
        "image/webp": [
          ".webp"
        ],
        "image/heic": [
          ".heic"
        ],
        "image/heif": [
          ".heif"
        ],
        "image/avif": [
          ".avif"
        ],
        "image/gif": [
          ".gif"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-new"
  },
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
