#!/bin/sh
# Regenerates tool list, footer, head links, manifests and service workers before every commit and stages the result.
# Enable once per clone:  git config core.hooksPath .githooks
if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: node not found – generated parts not updated (GitHub Action will do it)." >&2
  exit 0
fi
changed=$(node scripts/build.mjs --print-changed) || exit 1
[ -n "$changed" ] && echo "$changed" | while IFS= read -r f; do git add -- "$f"; done
exit 0
