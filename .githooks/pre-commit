#!/bin/sh
# Rebuilds the tool list (start page + README) before every commit.
# Enable once per clone:  git config core.hooksPath .githooks
if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: node not found – tool list not updated (GitHub Action will do it)." >&2
  exit 0
fi
node scripts/build-index.mjs || exit 1
git add index.html README.md
