{
  "id": "/medical-codes/",
  "name": "Kodiersysteme",
  "short_name": "Kodierung",
  "description": "ICD-10-GM, OPS, Alpha-ID-SE und weitere Downloads des BfArM durchsuchen und ansehen – offline, die Dateien bleiben auf dem Gerät.",
  "lang": "de",
  "name_localized": {
    "en": "Medical Codes"
  },
  "short_name_localized": {
    "en": "Med Codes"
  },
  "description_localized": {
    "en": "Search and view ICD-10-GM, OPS, Alpha-ID-SE and other BfArM downloads – offline, the files stay on the device."
  },
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4f6f9",
  "theme_color": "#6941c6",
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": [
            "application/zip",
            "application/xml",
            "text/plain",
            ".zip",
            ".xml",
            ".txt"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./?opened=1",
      "name": "Kodiersysteme",
      "accept": {
        "application/zip": [
          ".zip"
        ],
        "application/xml": [
          ".xml"
        ],
        "text/plain": [
          ".txt"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-new"
  },
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
