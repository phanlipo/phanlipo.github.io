{
  "id": "./",
  "name": "Videoanalyse",
  "short_name": "Videoanalyse",
  "description": "Bewegungen aus einem Handyvideo messen: Maßstab und Ursprung festlegen, das Objekt Bild für Bild antippen oder automatisch verfolgen lassen – Weg, Geschwindigkeit und Fit (linear, Wurf, Schwingung) mit Fehlern, Export als CSV.",
  "lang": "de",
  "name_localized": {
    "en": "Video Analysis"
  },
  "short_name_localized": {
    "en": "Video Lab"
  },
  "description_localized": {
    "en": "Measure motion from a phone video: set scale and origin, tap the object frame by frame or let it be tracked automatically – position, velocity and fits (linear, projectile, oscillation) with errors, export as CSV."
  },
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4f6f9",
  "theme_color": "#1e6091",
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": [
            "video/*",
            ".mp4",
            ".m4v",
            ".mov",
            ".webm"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./?opened=1",
      "name": "Videoanalyse",
      "accept": {
        "video/mp4": [
          ".mp4",
          ".m4v"
        ],
        "video/quicktime": [
          ".mov"
        ],
        "video/webm": [
          ".webm"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-new"
  },
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
