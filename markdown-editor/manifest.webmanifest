{
  "id": "./",
  "name": "Markdown-Editor",
  "short_name": "Markdown",
  "description": "Markdown schreiben – als Text oder formatiert ansehen und bearbeiten, mit Knöpfen für Fett, Listen, Links und mehr. Dateien im Verlauf teilen, herunterladen oder löschen.",
  "lang": "de",
  "name_localized": {
    "en": "Markdown Editor"
  },
  "short_name_localized": {
    "en": "Markdown"
  },
  "description_localized": {
    "en": "Write Markdown – view and edit it as text or formatted, with buttons for bold, lists, links and more. Share, download or delete files from the history."
  },
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4f6f9",
  "theme_color": "#475569",
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": [
            "text/markdown",
            "text/x-markdown",
            "text/plain",
            ".md",
            ".markdown",
            ".txt"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./?opened=1",
      "name": "Markdown-Editor",
      "accept": {
        "text/markdown": [
          ".md",
          ".markdown"
        ],
        "text/plain": [
          ".txt"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-new"
  },
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
