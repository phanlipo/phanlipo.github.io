{
  "id": "./",
  "name": "Sprache zu Text",
  "short_name": "Transkript",
  "description": "Sprachnachrichten (z. B. WhatsApp-Opus-Dateien) direkt im Browser in Text umwandeln – mit dem Whisper-Modell, ohne Upload: Das Audio verlässt das Gerät nicht.",
  "lang": "de",
  "name_localized": {
    "en": "Speech to Text"
  },
  "short_name_localized": {
    "en": "Transcript"
  },
  "description_localized": {
    "en": "Turn voice messages (e.g. WhatsApp Opus files) into text right in the browser – with the Whisper model, no upload: the audio never leaves the device."
  },
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4f6f9",
  "theme_color": "#0f766e",
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": [
            "audio/*",
            "audio/ogg",
            "audio/opus",
            ".opus",
            ".ogg",
            ".oga",
            ".m4a",
            ".mp3",
            ".wav",
            ".webm"
          ]
        }
      ]
    }
  },
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
