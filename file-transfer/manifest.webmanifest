{
  "id": "/file-transfer/",
  "name": "Dateiübertragung",
  "short_name": "Übertragen",
  "description": "Dateien und Texte direkt von Gerät zu Gerät schicken – per QR-Code verbunden, ohne Server, ohne Konto.",
  "lang": "de",
  "name_localized": {
    "en": "File Transfer"
  },
  "short_name_localized": {
    "en": "Transfer"
  },
  "description_localized": {
    "en": "Send files and texts directly from device to device – connected by QR code, no server, no account."
  },
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4f6f9",
  "theme_color": "#0369a1",
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": [
            "*/*",
            ".pdf",
            ".zip",
            ".jpg",
            ".jpeg",
            ".png",
            ".webp",
            ".heic",
            ".gif",
            ".mp4",
            ".mov",
            ".mp3",
            ".m4a",
            ".txt",
            ".csv"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./?opened=1",
      "name": "Dateiübertragung",
      "accept": {
        "application/pdf": [
          ".pdf"
        ],
        "application/zip": [
          ".zip"
        ],
        "image/jpeg": [
          ".jpg",
          ".jpeg"
        ],
        "image/png": [
          ".png"
        ],
        "image/webp": [
          ".webp"
        ],
        "image/heic": [
          ".heic"
        ],
        "image/gif": [
          ".gif"
        ],
        "video/mp4": [
          ".mp4"
        ],
        "video/quicktime": [
          ".mov"
        ],
        "audio/mpeg": [
          ".mp3"
        ],
        "audio/mp4": [
          ".m4a"
        ],
        "text/plain": [
          ".txt"
        ],
        "text/csv": [
          ".csv"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-new"
  },
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
